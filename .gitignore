# ==============================================================================
# ReguBOM Community Edition (CE) — .gitignore
# Strict isolation of Enterprise Edition (EE) proprietary modules & secrets
# ==============================================================================

# Enterprise Edition (EE) Proprietary Overlays & Packaging
backend/ee/
frontend/ee/
packaging/
helm/regubom-ee/
Dockerfile.ee
docker-compose.ee.yml

# Cryptographic License Files & Vendor Private/Public Keys
*.lic
*license_priv*.pem
*license_vendor_priv*.pem
*license*.pem
backend/app/core/keys/*license_vendor_priv*.pem
backend/ee/core/keys/
*.p12
*.key
*.crt
accessories/
security/

# Verification & Test Scripts for EE
ee_verification_test.py
*ee_verification_test*.py
backend/ee_verification_test.py

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.ruff_cache/
env/
venv/
ENV/
.venv/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Node & Frontend
frontend/node_modules/
frontend/dist/
frontend/.vite/
node_modules/
dist/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Databases, Storage & Uploads
*.db
*.db-journal
*.sqlite
*.sqlite3
backend/data/*.db
backend/uploads/*
!backend/uploads/.gitkeep
backend/reports/*
!backend/reports/.gitkeep
backend/exports/*
!backend/exports/.gitkeep
uploads/*
reports/*
sbom_validator.db

# Environment & Local Secrets
.env
.env.*
!.env.example

# IDE, OS & Scratch Artifacts
.vscode/
.idea/
.idx/
*.tmp
*.log
.DS_Store
Thumbs.db
SBOM_Report_Analisi_*.txt
